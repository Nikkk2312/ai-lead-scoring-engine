# AI Lead Scoring Engine - Environment Configuration
# Copy to .env and fill in values as needed

# --- LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Database ---
# SQLite (default) - just a file path
DATABASE_URL=sqlite:///lead_scorer.db
# Postgres - uncomment to use
# DATABASE_URL=postgresql://user:pass@localhost:5432/lead_scorer

# --- Notifications ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# --- Integrations ---
HUBSPOT_API_KEY=
APOLLO_API_KEY=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_SHEET_ID=

# --- Dashboard ---
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=change-me-to-random-string

# --- Auth ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Scheduling ---
CRON_EXPRESSION=0 6 * * 1

# --- Scoring ---
SCORE_FIT_WEIGHT=0.40
SCORE_ENGAGEMENT_WEIGHT=0.35
SCORE_INTENT_WEIGHT=0.25

# --- Score Decay ---
SCORE_DECAY_ENABLED=true
SCORE_DECAY_INTERVAL_DAYS=30
SCORE_DECAY_RATE=0.10
SCORE_DECAY_MODE=linear

# --- Tier Thresholds ---
TIER_HOT_MIN=70
TIER_WARM_MIN=40
